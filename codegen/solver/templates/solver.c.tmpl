/* Generated by Lumo. Newton with fixed scaling, partial-pivot LU and backtracking. */
#include "lumo_solver.h"
#include <float.h>
#include <math.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>
#define N ((size_t)LUMO_MESH_SIZE)

void lumo_solver_default_options(struct lumo_solver_options *options) {
    if (options != NULL) {
        const struct lumo_solver_options defaults = {100,30,1e-10,NULL,NULL,NULL,NULL,NULL,0};
        *options = defaults;
    }
}

static int admissible(const double *state, double flow_scale) {
    size_t j,i;
    for (i=0;i<N;++i) if (!isfinite(state[i])) return 0;
    for (j=0;j<LUMO_MESH_STAGES;++j) {
        size_t b=j*LUMO_MESH_BLOCK;
        for (i=0;i<2*LUMO_MESH_COMPONENTS;++i) {
            if (state[b+i] < -1e-12 || state[b+i] > 1.0+1e-12) return 0;
        }
        if (state[b+LUMO_MESH_L] < -1e-12*flow_scale) return 0;
        if (j>0 && state[b+LUMO_MESH_V] < -1e-12*flow_scale) return 0;
    }
    return 1;
}

static double scaled_norm(const double *r,const double *scale) {
    double norm=0.0;size_t i;
    for(i=0;i<N;++i) {
        double value=fabs(r[i]/scale[i]);
        if(!isfinite(value)) return INFINITY;
        norm=fmax(norm,value);
    }
    return norm;
}

static void history(const struct lumo_solver_options *options,struct lumo_solver_report *report) {
    if(report->history_count<options->history_capacity) {
        options->residual_history[report->history_count++]=report->residual_norm;
    }
}

static int linear_solve(double *a,double *b,double *x) {
    double largest=0.0;size_t i,j,k;
    for(i=0;i<N*N;++i){if(!isfinite(a[i]))return LUMO_SOLVER_NUMERIC_ERROR;largest=fmax(largest,fabs(a[i]));}
    if(largest==0.0)return LUMO_SOLVER_SINGULAR_JACOBIAN;
    for(k=0;k<N;++k){
        size_t pivot=k;
        for(i=k+1;i<N;++i)if(fabs(a[i*N+k])>fabs(a[pivot*N+k]))pivot=i;
        if(fabs(a[pivot*N+k])/largest<=64.0*DBL_EPSILON)return LUMO_SOLVER_SINGULAR_JACOBIAN;
        for(j=k;j<N;++j){double tmp=a[k*N+j];a[k*N+j]=a[pivot*N+j];a[pivot*N+j]=tmp;}
        {double tmp=b[k];b[k]=b[pivot];b[pivot]=tmp;}
        for(i=k+1;i<N;++i){
            double factor=a[i*N+k]/a[k*N+k];
            if(!isfinite(factor))return LUMO_SOLVER_NUMERIC_ERROR;
            for(j=k+1;j<N;++j){a[i*N+j]-=factor*a[k*N+j];if(!isfinite(a[i*N+j]))return LUMO_SOLVER_NUMERIC_ERROR;}
            a[i*N+k]=0.0;b[i]-=factor*b[k];
            if(!isfinite(b[i]))return LUMO_SOLVER_NUMERIC_ERROR;
        }
    }
    for(i=N;i-- >0;){
        double value=b[i];for(j=i+1;j<N;++j)value-=a[i*N+j]*x[j];
        x[i]=value/a[i*N+i];if(!isfinite(x[i]))return LUMO_SOLVER_NUMERIC_ERROR;
    }
    return LUMO_SOLVER_CONVERGED;
}

int lumo_solver_solve(const struct lumo_mesh_operating *operating,
                       double *state,const struct lumo_solver_options *provided,
                       struct lumo_solver_report *report) {
    struct lumo_solver_options defaults;
    const struct lumo_solver_options *options;
    struct lumo_mesh_numeric_options numeric;
    double *memory=NULL,*matrix,*r,*trial_r,*trial,*rhs,*delta,*xs,*rs;
    double flow=0.0,energy=0.0;
    int result=LUMO_SOLVER_INVALID_INPUT,model=0;
    size_t i,j;
    if(report==NULL)return result;
    {const struct lumo_solver_report initial={LUMO_SOLVER_INVALID_INPUT,0,0,0,NAN,0.0,0};*report=initial;}
    lumo_solver_default_options(&defaults);options=provided==NULL?&defaults:provided;
    if(operating==NULL||state==NULL||options->max_iterations<0||options->max_backtracks<0||options->max_backtracks>1000||
       !isfinite(options->residual_tolerance)||options->residual_tolerance<=0.0||
       (options->jacobian==NULL&&options->jacobian_context!=NULL)||
       (options->residual_history==NULL&&options->history_capacity!=0))goto finish;
    for(i=0;i<N;++i){
        if((options->variable_scales!=NULL&&(!isfinite(options->variable_scales[i])||options->variable_scales[i]<=0.0))||
           (options->residual_scales!=NULL&&(!isfinite(options->residual_scales[i])||options->residual_scales[i]<=0.0)))goto finish;
    }
    if(N>SIZE_MAX/N || N*N>SIZE_MAX-7*N || N*N+7*N>SIZE_MAX/sizeof(double)){
        result=LUMO_SOLVER_ALLOCATION_FAILED;goto finish;
    }
    memory=malloc((N*N+7*N)*sizeof(double));
    if(memory==NULL){result=LUMO_SOLVER_ALLOCATION_FAILED;goto finish;}
    matrix=memory;r=matrix+N*N;trial_r=r+N;trial=trial_r+N;rhs=trial+N;delta=rhs+N;xs=delta+N;rs=xs+N;
    model=lumo_mesh_residual(state,operating,r);
    if(model!=LUMO_MESH_OK){report->model_status=model;result=LUMO_SOLVER_MODEL_ERROR;goto finish;}
    for(i=0;i<LUMO_MESH_FEEDS;++i)flow+=operating->feeds[i].flow_mol_s;
    if(!admissible(state,flow))goto finish;
    /* Characteristic enthalpy from the initial phase states, not a hardcoded W scale. */
    for(j=0;j<LUMO_MESH_STAGES;++j){
        double e[LUMO_MESH_COMPONENTS],hl,hv;size_t b=j*LUMO_MESH_BLOCK;
        model=lumo_thermo_eval(state[b+LUMO_MESH_T],LUMO_MESH_PRESSURE_PA,state+b+LUMO_MESH_X,state+b+LUMO_MESH_Y,e,&hl,&hv);
        if(model!=LUMO_THERMO_OK){report->model_status=model;result=LUMO_SOLVER_MODEL_ERROR;goto finish;}
        energy=fmax(energy,fmax(fabs(hl),fabs(hv)));
    }
    energy=fmax(flow*fmax(1.0,energy),fmax(fabs(state[LUMO_MESH_QD]),fabs(state[LUMO_MESH_QW])));
    if(!isfinite(energy)||energy<=0.0){result=LUMO_SOLVER_NUMERIC_ERROR;goto finish;}
    for(i=0;i<N;++i){
        size_t offset=i%LUMO_MESH_BLOCK;
        xs[i]=1.0;rs[i]=1.0;
        if(i==LUMO_MESH_QD||i==LUMO_MESH_QW)xs[i]=energy;
        else if(offset==LUMO_MESH_T)xs[i]=fmax(1.0,fabs(state[i]));
        else if(offset==LUMO_MESH_L||offset==LUMO_MESH_V)xs[i]=flow;
        if(i==LUMO_MESH_CLOSURE||offset<LUMO_MESH_COMPONENTS)rs[i]=flow;
        else if(offset==LUMO_MESH_H)rs[i]=energy;
        if(options->variable_scales!=NULL)xs[i]=options->variable_scales[i];
        if(options->residual_scales!=NULL)rs[i]=options->residual_scales[i];
    }
    numeric.relative_step=0.0;numeric.variable_scales=xs;
    report->residual_norm=scaled_norm(r,rs);
    if(!isfinite(report->residual_norm)){result=LUMO_SOLVER_NUMERIC_ERROR;goto finish;}
    history(options,report);
    for(;;){
        int backtrack,accepted=0;
        double alpha=1.0;
        if(report->residual_norm<=options->residual_tolerance){result=LUMO_SOLVER_CONVERGED;goto finish;}
        if(report->iterations>=options->max_iterations){result=LUMO_SOLVER_MAX_ITERATIONS;goto finish;}
        if(options->jacobian==NULL)model=lumo_mesh_jacobian_numeric(state,operating,&numeric,matrix);
        else model=options->jacobian(state,operating,options->jacobian_context,matrix);
        if(model!=LUMO_MESH_OK){report->model_status=model;result=LUMO_SOLVER_MODEL_ERROR;goto finish;}
        for(i=0;i<N;++i){rhs[i]=-r[i]/rs[i];for(j=0;j<N;++j)matrix[i*N+j]=(matrix[i*N+j]*xs[j])/rs[i];}
        result=linear_solve(matrix,rhs,delta);if(result!=LUMO_SOLVER_CONVERGED)goto finish;
        for(backtrack=0;backtrack<=options->max_backtracks;++backtrack){
            double norm;
            for(i=0;i<N;++i)trial[i]=state[i]+alpha*xs[i]*delta[i];
            model=0;
            if(admissible(trial,flow)){
                model=lumo_mesh_residual(trial,operating,trial_r);
                if(model==LUMO_MESH_OK){
                    norm=scaled_norm(trial_r,rs);
                    if(isfinite(norm)&&norm<report->residual_norm&&norm<=(1.0-1e-4*alpha)*report->residual_norm){
                        double step=0.0;
                        for(i=0;i<N;++i)step=fmax(step,fabs((trial[i]-state[i])/xs[i]));
                        memcpy(state,trial,N*sizeof(double));memcpy(r,trial_r,N*sizeof(double));
                        report->step_norm=step;report->residual_norm=norm;report->model_status=0;
                        ++report->iterations;history(options,report);accepted=1;break;
                    }
                }
            }
            if(model!=LUMO_MESH_OK)report->model_status=model;
            ++report->backtracks;alpha*=0.5;
        }
        if(!accepted){result=LUMO_SOLVER_LINE_SEARCH_FAILED;goto finish;}
    }
finish:
    free(memory);report->status=(enum lumo_solver_status)result;return result;
}
