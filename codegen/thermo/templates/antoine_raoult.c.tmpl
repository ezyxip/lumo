/* Generated by Lumo. Antoine + ideal Raoult, ideal constant-Cp enthalpies. */
#include "lumo_thermo.h"
#include <float.h>
#include <math.h>
#include <stddef.h>

/* Conventional mmHg to Pa, rounded as in NIST SP 811, Appendix B.9. */
#define LUMO_MMHG_TO_PA 133.3224

struct lumo_component_properties {
    double a, b, c;
    double reference_K, cp_liquid, cp_vapor, vaporization_enthalpy;
    double min_K, max_K;
};

static const struct lumo_component_properties
lumo_properties[LUMO_THERMO_COMPONENTS] = {
{{range .Components}}    { {{literal .Properties.Antoine.A}}, {{literal .Properties.Antoine.B}}, {{literal .Properties.Antoine.C}},
      {{literal .Properties.Enthalpy.ReferenceTemperatureK}}, {{literal .Properties.Enthalpy.LiquidCPJMolK}}, {{literal .Properties.Enthalpy.VaporCPJMolK}}, {{literal .Properties.Enthalpy.VaporizationEnthalpyAtReferenceJMol}},
      {{literal .Properties.TemperatureRangeK.Min}}, {{literal .Properties.TemperatureRangeK.Max}} },
{{end}}};

static int lumo_equilibrium_constants(double temperature_K, double pressure_Pa, double *k) {
    size_t i;
    if (!isfinite(temperature_K) || temperature_K <= 0.0 || !isfinite(pressure_Pa) || pressure_Pa <= 0.0) return LUMO_THERMO_INVALID_INPUT;
    for (i = 0; i < LUMO_THERMO_COMPONENTS; ++i) {
        const struct lumo_component_properties *p = &lumo_properties[i];
        double denominator, psat;
        if (temperature_K < p->min_K || temperature_K > p->max_K) return LUMO_THERMO_TEMPERATURE_RANGE;
        denominator = p->c + (temperature_K - 273.15);
        if (!isfinite(denominator) || denominator == 0.0) return LUMO_THERMO_NUMERIC_ERROR;
        psat = LUMO_MMHG_TO_PA * pow(10.0, p->a - p->b / denominator);
        k[i] = psat / pressure_Pa;
        if (!isfinite(psat) || psat <= 0.0 || !isfinite(k[i]) || k[i] <= 0.0) return LUMO_THERMO_NUMERIC_ERROR;
    }
    return LUMO_THERMO_OK;
}

int lumo_thermo_eval(
    double temperature_K,
    double pressure_Pa,
    const double *x,
    const double *y,
    double *equilibrium_residuals,
    double *h_liquid,
    double *h_vapor
) {
    double residuals[LUMO_THERMO_COMPONENTS], k[LUMO_THERMO_COMPONENTS];
    int status;
    double liquid = 0.0;
    double vapor = 0.0;
    size_t i;

    if (x == NULL || y == NULL || equilibrium_residuals == NULL ||
        h_liquid == NULL || h_vapor == NULL ||
        !isfinite(temperature_K) || temperature_K <= 0.0 ||
        !isfinite(pressure_Pa) || pressure_Pa <= 0.0) {
        return LUMO_THERMO_INVALID_INPUT;
    }

    status = lumo_equilibrium_constants(temperature_K, pressure_Pa, k);
    if (status != LUMO_THERMO_OK) return status;
    for (i = 0; i < LUMO_THERMO_COMPONENTS; ++i) {
        const struct lumo_component_properties *p = &lumo_properties[i];
        double delta_T;
        if (!isfinite(x[i]) || !isfinite(y[i])) {
            return LUMO_THERMO_INVALID_INPUT;
        }
        residuals[i] = y[i] - k[i] * x[i];
        delta_T = temperature_K - p->reference_K;
        liquid += x[i] * p->cp_liquid * delta_T;
        vapor += y[i] * (p->vaporization_enthalpy + p->cp_vapor * delta_T);
        if (!isfinite(residuals[i]) || !isfinite(liquid) || !isfinite(vapor)) {
            return LUMO_THERMO_NUMERIC_ERROR;
        }
    }

    for (i = 0; i < LUMO_THERMO_COMPONENTS; ++i) {
        equilibrium_residuals[i] = residuals[i];
    }
    *h_liquid = liquid;
    *h_vapor = vapor;
    return LUMO_THERMO_OK;
}
