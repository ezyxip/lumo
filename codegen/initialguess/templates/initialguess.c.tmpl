/* Generated by Lumo. Heuristic linear profiles with a saturated-liquid flow seed. */
#include "lumo_initialguess.h"
#include <math.h>
#include <stddef.h>

static const size_t feed_stage[LUMO_MESH_FEEDS] = {
{{range .Column.Feeds}}    {{.Stage}} - 1,
{{end}}};

int lumo_initialguess_linear_T_x(const struct lumo_mesh_operating *operating,
                                 double *state) {
    double candidate[LUMO_MESH_SIZE] = {0}, residual[LUMO_MESH_SIZE];
    double z[LUMO_MESH_COMPONENTS] = {0}, direction[LUMO_MESH_COMPONENTS];
    double top_x[LUMO_MESH_COMPONENTS], bottom_x[LUMO_MESH_COMPONENTS];
    double hl[LUMO_MESH_STAGES], hv[LUMO_MESH_STAGES], e[LUMO_MESH_COMPONENTS];
    struct lumo_flash_result average, top, bottom;
    double total = 0.0, distillate, bottoms, theta, strength = 1.0, liquid, vapor;
    size_t f, i, j;
    int status, attempt;
    if (operating == NULL || state == NULL) return LUMO_THERMO_INVALID_INPUT;
    distillate = operating->distillate_mol_s;
    if (!isfinite(distillate) || distillate <= 0.0 ||
        !isfinite(operating->reflux_ratio) || operating->reflux_ratio < 0.0) return LUMO_THERMO_INVALID_INPUT;
    for (f = 0; f < LUMO_MESH_FEEDS; ++f) {
        const struct lumo_mesh_feed *feed = &operating->feeds[f];
        double sum = 0.0;
        if (!isfinite(feed->flow_mol_s) || feed->flow_mol_s <= 0.0 || !isfinite(feed->enthalpy_J_mol)) return LUMO_THERMO_INVALID_INPUT;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            if (!isfinite(feed->mole_fractions[i]) || feed->mole_fractions[i] < 0.0 || feed->mole_fractions[i] > 1.0) return LUMO_THERMO_INVALID_INPUT;
            sum += feed->mole_fractions[i];
        }
        if (fabs(sum-1.0) > 1e-10) return LUMO_THERMO_INVALID_INPUT;
        total += feed->flow_mol_s;
    }
    if (!isfinite(total)) return LUMO_THERMO_NUMERIC_ERROR;
    if (distillate >= total) return LUMO_THERMO_INVALID_INPUT;
    bottoms = total-distillate;
    theta = distillate/total;
    /* Divide before accumulating to avoid overflowing component feed totals. */
    for (f = 0; f < LUMO_MESH_FEEDS; ++f) {
        double sum = 0.0;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) sum += operating->feeds[f].mole_fractions[i];
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            z[i] += (operating->feeds[f].flow_mol_s/total)*(operating->feeds[f].mole_fractions[i]/sum);
        }
    }
    status = lumo_thermo_flash(LUMO_FEED_SATURATED_LIQUID,0.0,LUMO_MESH_PRESSURE_PA,z,&average);
    if (status != LUMO_THERMO_OK) return status;
    /* Remove flash roundoff before forming a zero enrichment direction
     * for pure feeds. Their incipient vapor must normalize to exactly 1.
     */
    {
        double sum_y = 0.0;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) sum_y += average.y[i];
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            z[i] = average.x[i];
            average.y[i] /= sum_y;
        }
    }
    /* Enrichment direction from the vapor above the aggregate feed liquid.
     * xD=z+(B/F)*direction, xB=z-(D/F)*direction preserves product balance.
     */
    for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
        direction[i] = 2.0*(average.y[i]-z[i]);
        if (direction[i] > 0.0) strength = fmin(strength,0.9*z[i]/(theta*direction[i]));
        else if (direction[i] < 0.0) strength = fmin(strength,0.9*z[i]/((bottoms/total)*-direction[i]));
    }
    /* Back off enrichment if product bubble points leave the property range.
     * Final fallback is the aggregate composition, already flashed above.
     */
    for (attempt = 0; attempt <= 32; ++attempt) {
        double scale = attempt == 32 ? 0.0 : strength;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            top_x[i] = z[i] + (bottoms/total)*scale*direction[i];
            bottom_x[i] = z[i] - theta*scale*direction[i];
        }
        status = lumo_thermo_flash(LUMO_FEED_SATURATED_LIQUID,0.0,LUMO_MESH_PRESSURE_PA,top_x,&top);
        if (status == LUMO_THERMO_OK) status = lumo_thermo_flash(LUMO_FEED_SATURATED_LIQUID,0.0,LUMO_MESH_PRESSURE_PA,bottom_x,&bottom);
        if (status == LUMO_THERMO_OK) break;
        if (status != LUMO_THERMO_TEMPERATURE_RANGE && status != LUMO_THERMO_FLASH_NO_CONVERGENCE) return status;
        strength *= 0.5;
    }
    if (status != LUMO_THERMO_OK) return status;
    liquid = operating->reflux_ratio*distillate;
    vapor = liquid+distillate;
    if (!isfinite(liquid) || !isfinite(vapor) || vapor <= 0.0) return LUMO_THERMO_NUMERIC_ERROR;
    for (j = 0; j < LUMO_MESH_STAGES; ++j) {
        size_t b = j*LUMO_MESH_BLOCK;
        double t = (double)j/(LUMO_MESH_STAGES-1);
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            candidate[b+LUMO_MESH_X+i] = (1.0-t)*top.x[i]+t*bottom.x[i];
            candidate[b+LUMO_MESH_Y+i] = (1.0-t)*top.y[i]+t*bottom.y[i];
        }
        candidate[b+LUMO_MESH_T] = (1.0-t)*top.temperature_K+t*bottom.temperature_K;
        for (f = 0; f < LUMO_MESH_FEEDS; ++f) if (feed_stage[f] == j) liquid += operating->feeds[f].flow_mol_s;
        candidate[b+LUMO_MESH_L] = j+1 == LUMO_MESH_STAGES ? bottoms : liquid;
        if (j > 0) candidate[b+LUMO_MESH_V] = vapor;
        status = lumo_thermo_eval(candidate[b+LUMO_MESH_T],LUMO_MESH_PRESSURE_PA,
            candidate+b+LUMO_MESH_X,candidate+b+LUMO_MESH_Y,e,&hl[j],&hv[j]);
        if (status != LUMO_THERMO_OK) return status;
    }
    candidate[LUMO_MESH_QD] = vapor*hv[1]-(candidate[LUMO_MESH_L]+distillate)*hl[0];
    candidate[LUMO_MESH_QW] = bottoms*hl[LUMO_MESH_STAGES-1]+vapor*hv[LUMO_MESH_STAGES-1]
        -candidate[(LUMO_MESH_STAGES-2)*LUMO_MESH_BLOCK+LUMO_MESH_L]*hl[LUMO_MESH_STAGES-2];
    /* Includes final finite checks and operating-input validation. */
    status = lumo_mesh_residual(candidate,operating,residual);
    if (status != LUMO_MESH_OK) return status;
    for (i = 0; i < LUMO_MESH_SIZE; ++i) state[i] = candidate[i];
    return LUMO_THERMO_OK;
}
