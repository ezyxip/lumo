#ifndef LUMO_MESH_HEADER_INCLUDED
#define LUMO_MESH_HEADER_INCLUDED
#include "lumo_thermo.h"

#define LUMO_MESH_STAGES {{.Stages}}
#define LUMO_MESH_COMPONENTS {{.Components}}
#define LUMO_MESH_FEEDS {{len .Feeds}}
#define LUMO_MESH_BLOCK (2 * LUMO_MESH_COMPONENTS + 3)
#define LUMO_MESH_SIZE {{.Variables}}
#define LUMO_MESH_PRESSURE_PA {{.Pressure}}
{{range .Feeds}}#define LUMO_MESH_FEED_{{.Index}}_STAGE {{.Stage}}
{{end}}
/* State block: x[C], y[C], T, L, V (QD at stage zero).
 * Last-stage L is bottoms flow B. QW follows all stage blocks.
 * y at the total condenser is formal incipient vapor, not an output stream.
 */
#define LUMO_MESH_X 0
#define LUMO_MESH_Y LUMO_MESH_COMPONENTS
#define LUMO_MESH_T (2 * LUMO_MESH_COMPONENTS)
#define LUMO_MESH_L (2 * LUMO_MESH_COMPONENTS + 1)
#define LUMO_MESH_V (2 * LUMO_MESH_COMPONENTS + 2)
#define LUMO_MESH_QD LUMO_MESH_V
#define LUMO_MESH_QW (LUMO_MESH_STAGES * LUMO_MESH_BLOCK)

/* Residual block: M[C], E[C], Sx, Sy, H. Reflux closure follows all blocks. */
#define LUMO_MESH_M 0
#define LUMO_MESH_E LUMO_MESH_COMPONENTS
#define LUMO_MESH_SX (2 * LUMO_MESH_COMPONENTS)
#define LUMO_MESH_SY (2 * LUMO_MESH_COMPONENTS + 1)
#define LUMO_MESH_H (2 * LUMO_MESH_COMPONENTS + 2)
#define LUMO_MESH_CLOSURE (LUMO_MESH_SIZE - 1)

enum lumo_mesh_status {
    LUMO_MESH_OK = LUMO_THERMO_OK,
    LUMO_MESH_INVALID_INPUT = LUMO_THERMO_INVALID_INPUT,
    LUMO_MESH_TEMPERATURE_RANGE = LUMO_THERMO_TEMPERATURE_RANGE,
    LUMO_MESH_NUMERIC_ERROR = LUMO_THERMO_NUMERIC_ERROR
};

struct lumo_mesh_feed {
    double flow_mol_s;
    double mole_fractions[LUMO_MESH_COMPONENTS];
    double enthalpy_J_mol;
};

struct lumo_mesh_operating {
    struct lumo_mesh_feed feeds[LUMO_MESH_FEEDS];
    double distillate_mol_s;
    double reflux_ratio;
};

/* state and residual contain LUMO_MESH_SIZE doubles each.
 * Feed enthalpies and compositions must use the generated thermo reference.
 * Runtime inputs are normalized values, not raw JSON. The closure is molar.
 * Residuals are unscaled: M/closure in mol/s, E/S dimensionless, H in W.
 * Finite unnormalized state iterates are accepted without clipping.
 * On error residual is unchanged; status includes thermodynamic errors.
 */
int lumo_mesh_residual(const double *state,
                       const struct lumo_mesh_operating *operating,
                       double *residual);
#endif
