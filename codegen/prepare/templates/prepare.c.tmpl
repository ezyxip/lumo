/* Generated by Lumo. Unit conversion and feed flash, independent of solver. */
#include "lumo_prepare.h"
#include <math.h>
#include <stddef.h>

static const double molar_mass_g_mol[LUMO_MESH_COMPONENTS] = {
{{range .Components}}    {{.MolarMassGMol}},
{{end}}};

int lumo_prepare_operating(const struct lumo_prepare_input *input,
                            struct lumo_mesh_operating *operating) {
    struct lumo_mesh_operating candidate;
    double total_feed = 0.0;
    size_t f, i;
    if (input == NULL || operating == NULL) return LUMO_PREPARE_INVALID_INPUT;
    if (!isfinite(input->distillate_flow) || input->distillate_flow <= 0.0 ||
        !isfinite(input->reflux_ratio) || input->reflux_ratio < 0.0) return LUMO_PREPARE_INVALID_INPUT;
    switch (input->distillate_unit) {
    case LUMO_FLOW_MOL_S: candidate.distillate_mol_s = input->distillate_flow; break;
    case LUMO_FLOW_KMOL_H: candidate.distillate_mol_s = input->distillate_flow/3.6; break;
    case LUMO_FLOW_KG_H: return LUMO_PREPARE_UNSUPPORTED_SPECIFICATION;
    default: return LUMO_PREPARE_INVALID_INPUT;
    }
    if (!isfinite(candidate.distillate_mol_s) || candidate.distillate_mol_s <= 0.0) return LUMO_PREPARE_NUMERIC_ERROR;
    candidate.reflux_ratio = input->reflux_ratio;
    for (f = 0; f < LUMO_MESH_FEEDS; ++f) {
        const struct lumo_prepare_feed *feed = &input->feeds[f];
        struct lumo_flash_result flash;
        double z[LUMO_MESH_COMPONENTS], sum = 0.0, molar_sum = 0.0, mw = 0.0, flow;
        int status;
        if (!isfinite(feed->flow) || feed->flow <= 0.0) return LUMO_PREPARE_INVALID_INPUT;
        if (feed->composition_basis != LUMO_COMPOSITION_MOLE && feed->composition_basis != LUMO_COMPOSITION_MASS) return LUMO_PREPARE_INVALID_INPUT;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            double fraction = feed->fractions[i];
            if (!isfinite(fraction) || fraction < 0.0 || fraction > 1.0) return LUMO_PREPARE_INVALID_INPUT;
            sum += fraction;
            z[i] = feed->composition_basis == LUMO_COMPOSITION_MASS ? fraction/molar_mass_g_mol[i] : fraction;
            molar_sum += z[i];
        }
        if (!isfinite(sum) || fabs(sum-1.0) > 1e-10) return LUMO_PREPARE_INVALID_INPUT;
        if (!isfinite(molar_sum) || molar_sum <= 0.0) return LUMO_PREPARE_NUMERIC_ERROR;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) {
            z[i] /= molar_sum;
            mw += z[i]*molar_mass_g_mol[i];
        }
        if (!isfinite(mw) || mw <= 0.0) return LUMO_PREPARE_NUMERIC_ERROR;
        switch (feed->flow_unit) {
        case LUMO_FLOW_MOL_S: flow = feed->flow; break;
        case LUMO_FLOW_KMOL_H: flow = feed->flow/3.6; break;
        case LUMO_FLOW_KG_H: flow = (feed->flow/3.6)/mw; break;
        default: return LUMO_PREPARE_INVALID_INPUT;
        }
        if (!isfinite(flow) || flow <= 0.0) return LUMO_PREPARE_NUMERIC_ERROR;
        status = lumo_thermo_flash(feed->state, feed->state_value, LUMO_MESH_PRESSURE_PA, z, &flash);
        if (status != LUMO_THERMO_OK) return status;
        candidate.feeds[f].flow_mol_s = flow;
        candidate.feeds[f].enthalpy_J_mol = flash.enthalpy_J_mol;
        for (i = 0; i < LUMO_MESH_COMPONENTS; ++i) candidate.feeds[f].mole_fractions[i] = z[i];
        total_feed += flow;
    }
    if (!isfinite(total_feed)) return LUMO_PREPARE_NUMERIC_ERROR;
    if (candidate.distillate_mol_s >= total_feed) return LUMO_PREPARE_INVALID_INPUT;
    *operating = candidate;
    return LUMO_PREPARE_OK;
}
