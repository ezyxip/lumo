/* Generated by Lumo. Structured runtime input, before unit conversion/flash. */
#ifndef LUMO_PREPARE_HEADER_INCLUDED
#define LUMO_PREPARE_HEADER_INCLUDED
#include "lumo_mesh.h"

enum lumo_flow_unit { LUMO_FLOW_MOL_S, LUMO_FLOW_KMOL_H, LUMO_FLOW_KG_H };
enum lumo_composition_basis { LUMO_COMPOSITION_MOLE, LUMO_COMPOSITION_MASS };
enum lumo_prepare_status {
    LUMO_PREPARE_OK = LUMO_THERMO_OK,
    LUMO_PREPARE_INVALID_INPUT = LUMO_THERMO_INVALID_INPUT,
    LUMO_PREPARE_TEMPERATURE_RANGE = LUMO_THERMO_TEMPERATURE_RANGE,
    LUMO_PREPARE_NUMERIC_ERROR = LUMO_THERMO_NUMERIC_ERROR,
    LUMO_PREPARE_FLASH_AMBIGUOUS = LUMO_THERMO_FLASH_AMBIGUOUS,
    LUMO_PREPARE_FLASH_NO_CONVERGENCE = LUMO_THERMO_FLASH_NO_CONVERGENCE,
    LUMO_PREPARE_UNSUPPORTED_SPECIFICATION = 6
};

struct lumo_prepare_feed {
    double flow;
    enum lumo_flow_unit flow_unit;
    enum lumo_composition_basis composition_basis;
    double fractions[LUMO_MESH_COMPONENTS];
    enum lumo_feed_state state;
    /* T [K] or molar vapor fraction; ignored for saturated_liquid. */
    double state_value;
};

struct lumo_prepare_input {
    struct lumo_prepare_feed feeds[LUMO_MESH_FEEDS];
    double distillate_flow;
    enum lumo_flow_unit distillate_unit;
    double reflux_ratio; /* molar */
};

/* Arrays use the generated component/feed order. JSON IDs must be resolved
 * before calling. All feeds flash at the compiled constant column pressure.
 * Fractions must sum to 1 within 1e-10; roundoff is normalized after validation.
 * D must be mol_s/kmol_h; kg_h returns UNSUPPORTED_SPECIFICATION.
 * On error operating is unchanged. Inputs/outputs must not overlap.
 * This function neither parses JSON nor constructs an initial stage profile.
 */
int lumo_prepare_operating(const struct lumo_prepare_input *input,
                            struct lumo_mesh_operating *operating);
#endif
