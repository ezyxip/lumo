/* Generated by Lumo. Model-independent dense Jacobian interface. */
#ifndef LUMO_JACOBIAN_HEADER_INCLUDED
#define LUMO_JACOBIAN_HEADER_INCLUDED
#include <stddef.h>
#define LUMO_JACOBIAN_SIZE {{.}}

enum lumo_jacobian_status {
    LUMO_JACOBIAN_OK = 0,
    LUMO_JACOBIAN_INVALID_INPUT = 1,
    LUMO_JACOBIAN_DOMAIN_ERROR = 2,
    LUMO_JACOBIAN_NUMERIC_ERROR = 3
};

/* Callback returns lumo_jacobian_status. DOMAIN_ERROR means that a finite
 * state lies outside the model's valid domain. Context may be NULL.
 * State and output each contain SIZE elements. Inputs must not be modified.
 */
typedef int (*lumo_residual_fn)(const double *state, const void *context,
                                double *residual);

/* Common signature for numeric, analytic and AD implementations.
 * Contexts are read-only and backend-specific options use their own context.
 * J[row * SIZE + col] = d residual[row] / d state[col], without scaling.
 * Output has SIZE*SIZE elements and must not overlap inputs or contexts.
 * On error output may be partially written and must be discarded.
 */
typedef int (*lumo_jacobian_fn)(const double *state, lumo_residual_fn residual,
                                const void *residual_context,
                                const void *context, double *jacobian);

struct lumo_jacobian_numeric_options {
    /* Zero selects cbrt(DBL_EPSILON). Otherwise finite and positive. */
    double relative_step;
    /* Optional SIZE positive finite scales in state units. NULL selects 1. */
    const double *variable_scales;
};

/* Context is NULL or points to lumo_jacobian_numeric_options.
 * step = relative_step * max(abs(state[col]), scale[col]).
 * Central differences; one-sided differences if one probe returns DOMAIN_ERROR.
 * Both probes outside domain return DOMAIN_ERROR. Other errors propagate.
 * Additional scratch space is O(SIZE) on the stack.
 */
int lumo_jacobian_numeric(const double *state, lumo_residual_fn residual,
                           const void *residual_context,
                           const void *context, double *jacobian);
#endif
