/* Generated by Lumo. Model-independent numerical Jacobian. */
#include "lumo_jacobian.h"
#include <float.h>
#include <math.h>

int lumo_jacobian_numeric(const double *state, lumo_residual_fn residual,
                           const void *residual_context,
                           const void *context, double *jacobian) {
    const struct lumo_jacobian_numeric_options *options = context;
    double shifted[LUMO_JACOBIAN_SIZE], base[LUMO_JACOBIAN_SIZE];
    double plus[LUMO_JACOBIAN_SIZE], minus[LUMO_JACOBIAN_SIZE];
    double relative_step = cbrt(DBL_EPSILON);
    size_t row, col;
    int status;
    if (state == NULL || residual == NULL || jacobian == NULL) {
        return LUMO_JACOBIAN_INVALID_INPUT;
    }
    if (options != NULL) {
        if (!isfinite(options->relative_step) || options->relative_step < 0.0) {
            return LUMO_JACOBIAN_INVALID_INPUT;
        }
        if (options->relative_step > 0.0) relative_step = options->relative_step;
        if (options->variable_scales != NULL) {
            for (col = 0; col < LUMO_JACOBIAN_SIZE; ++col) {
                if (!isfinite(options->variable_scales[col]) || options->variable_scales[col] <= 0.0) {
                    return LUMO_JACOBIAN_INVALID_INPUT;
                }
            }
        }
    }
    for (col = 0; col < LUMO_JACOBIAN_SIZE; ++col) {
        if (!isfinite(state[col])) return LUMO_JACOBIAN_INVALID_INPUT;
    }
    status = residual(state, residual_context, base);
    if (status != LUMO_JACOBIAN_OK) return status;
    for (col = 0; col < LUMO_JACOBIAN_SIZE; ++col) shifted[col] = state[col];
    for (col = 0; col < LUMO_JACOBIAN_SIZE; ++col) {
        double scale = options != NULL && options->variable_scales != NULL ? options->variable_scales[col] : 1.0;
        double step = relative_step * fmax(fabs(state[col]), scale);
        double upper = state[col] + step, lower = state[col] - step;
        double denominator;
        int positive, negative;
        if (!isfinite(step) || !isfinite(upper) || !isfinite(lower) ||
            upper <= state[col] || lower >= state[col]) return LUMO_JACOBIAN_NUMERIC_ERROR;
        shifted[col] = upper;
        positive = residual(shifted, residual_context, plus);
        shifted[col] = lower;
        negative = residual(shifted, residual_context, minus);
        shifted[col] = state[col];
        if (positive != LUMO_JACOBIAN_OK && positive != LUMO_JACOBIAN_DOMAIN_ERROR) return positive;
        if (negative != LUMO_JACOBIAN_OK && negative != LUMO_JACOBIAN_DOMAIN_ERROR) return negative;
        if (positive != LUMO_JACOBIAN_OK && negative != LUMO_JACOBIAN_OK) return LUMO_JACOBIAN_DOMAIN_ERROR;
        denominator = positive == LUMO_JACOBIAN_OK ?
            (negative == LUMO_JACOBIAN_OK ? upper - lower : upper - state[col]) : state[col] - lower;
        if (!isfinite(denominator) || denominator <= 0.0) return LUMO_JACOBIAN_NUMERIC_ERROR;
        for (row = 0; row < LUMO_JACOBIAN_SIZE; ++row) {
            double high = positive == LUMO_JACOBIAN_OK ? plus[row] : base[row];
            double low = negative == LUMO_JACOBIAN_OK ? minus[row] : base[row];
            double value = (high - low) / denominator;
            if (!isfinite(value)) return LUMO_JACOBIAN_NUMERIC_ERROR;
            jacobian[row * (size_t)LUMO_JACOBIAN_SIZE + col] = value;
        }
    }
    return LUMO_JACOBIAN_OK;
}
